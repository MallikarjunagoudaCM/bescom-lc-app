# ─────────────────────────────────────────────────────────────
# BESCOM Transfer System — Backend Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git.

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development        # change to: production on Azure

# ── MongoDB Atlas ─────────────────────────────────────────────
# Get this from: Atlas → Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/bescom_transfer?retryWrites=true&w=majority

# ── JWT Auth ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Local dev:
ALLOWED_ORIGINS=http://localhost:3000
# After Azure deploy, add your frontend URL:
# ALLOWED_ORIGINS=http://localhost:3000,https://bescom-transfer-ui.azurewebsites.net
